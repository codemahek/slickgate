<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Slickgate.Gateway</RootNamespace>
    <!--
      Native AOT is opt-in so day-to-day `dotnet run` stays fast:
        dotnet publish -c Release -p:SlickgateAot=true
      The Dockerfile passes this automatically in aot publish mode.
    -->
    <PublishAot Condition="'$(SlickgateAot)' == 'true'">true</PublishAot>
    <IsAotCompatible Condition="'$(PublishAot)' == 'true'">true</IsAotCompatible>
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(SlickgateAot)' == 'true'">
    <!-- Certes + BouncyCastle are not fully trim-annotated yet; root them so the
         ACME certificate path keeps working under Native AOT. -->
    <TrimmerRootAssembly Include="Certes" />
    <TrimmerRootAssembly Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SlickgateAot)' == 'true'">
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slickgate.Core\Slickgate.Core.csproj" />
  </ItemGroup>

</Project>
