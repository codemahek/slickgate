<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Slickgate.Core</RootNamespace>
    <!-- .NET 11 "runtime async": JIT lowers async/await instead of the compiler.
         Opt out with -p:SlickgateRuntimeAsync=off (used by the benchmark harness). -->
    <Features Condition="'$(SlickgateRuntimeAsync)' != 'off'">$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
