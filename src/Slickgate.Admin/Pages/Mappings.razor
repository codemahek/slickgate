@page "/mappings"
@inherits ReactiveComponentBase<MappingsViewModel>
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Slickgate · Mappings</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Mappings</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Admin-managed routes persisted to the generated overlay file. Overrides file routes; Docker labels are applied last.
</MudText>

@if (ViewModel!.ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">@ViewModel!.ErrorMessage</MudAlert>
}

<MudTable Items="@ViewModel!.Mappings" Loading="@ViewModel!.IsLoading" Hover="true" Dense="true" Breakpoint="Breakpoint.Md">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Mappings (@ViewModel!.Mappings.Count)</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateAsync">New mapping</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@(() => ViewModel!.RefreshAsync())" Class="ml-2" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Hosts</MudTh>
        <MudTh>Path</MudTh>
        <MudTh>Upstreams</MudTh>
        <MudTh>TLS</MudTh>
        <MudTh>Order</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Id"><code>@context.Id</code></MudTd>
        <MudTd DataLabel="Hosts">
            @if (context.Hosts is { Count: > 0 })
            {
                @foreach (var host in context.Hosts)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">@host</MudChip>
                }
            }
            else
            {
                <span class="mud-text-secondary">any</span>
            }
        </MudTd>
        <MudTd DataLabel="Path">
            <code>@(context.PathExact ?? context.PathPrefix ?? "/")</code>
            @if (!string.IsNullOrEmpty(context.StripPrefix))
            {
                <MudText Typo="Typo.caption">strip <code>@context.StripPrefix</code></MudText>
            }
        </MudTd>
        <MudTd DataLabel="Upstreams">
            @foreach (var upstream in context.Upstreams ?? [])
            {
                <div><code>@upstream</code></div>
            }
        </MudTd>
        <MudTd DataLabel="TLS">
            <MudChip T="string" Size="Size.Small" Color="@(context.Tls == "off" ? Color.Default : Color.Success)">@(context.Tls ?? "off")</MudChip>
        </MudTd>
        <MudTd DataLabel="Order">@(context.Order?.ToString() ?? "—")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => DeleteAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No admin mappings yet. Create one to override the file config.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private async Task CreateAsync()
    {
        var parameters = new DialogParameters<MappingEditorDialog>
        {
            { x => x.Model, new RouteMapping(null, null, "/", null, null, null, "off", null, null, null, null) },
            { x => x.IsNew, true },
        };

        await ShowEditorAsync("New mapping", parameters);
    }

    private async Task EditAsync(RouteMapping mapping)
    {
        var parameters = new DialogParameters<MappingEditorDialog>
        {
            { x => x.Model, mapping },
            { x => x.IsNew, false },
        };

        await ShowEditorAsync($"Edit '{mapping.Id}'", parameters);
    }

    private async Task ShowEditorAsync(string title, DialogParameters<MappingEditorDialog> parameters)
    {
        var dialog = await DialogService.ShowAsync<MappingEditorDialog>(title, parameters);
        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: RouteMapping mapping })
        {
            return;
        }

        var error = await ViewModel!.SaveAsync(mapping);
        if (error is null)
        {
            Snackbar.Add($"Mapping '{mapping.Id}' saved.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private async Task DeleteAsync(RouteMapping mapping)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete mapping",
            $"Delete mapping '{mapping.Id}'? This removes it from the generated overlay file.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        var error = await ViewModel!.DeleteAsync(mapping.Id ?? "");
        if (error is null)
        {
            Snackbar.Add($"Mapping '{mapping.Id}' deleted.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    protected override MappingsViewModel CreateViewModel(IServiceProvider serviceProvider) =>
        serviceProvider.GetRequiredService<MappingsViewModel>();
}
