@page "/containers"
@inherits ReactiveComponentBase<ContainersViewModel>
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Slickgate · Containers</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Docker Containers</MudText>

@if (ViewModel!.Response is { DockerEnabled: false })
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
        Docker discovery is disabled. Enable <code>docker.enabled</code> in the gateway configuration to discover containers.
    </MudAlert>
}

@if (ViewModel!.Response?.Error is { } dockerError)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
        Could not reach the Docker daemon: @dockerError
    </MudAlert>
}

@if (ViewModel!.ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">@ViewModel!.ErrorMessage</MudAlert>
}

<MudTable Items="@ViewModel!.Containers" Loading="@ViewModel!.IsLoading" Hover="true" Dense="true" Breakpoint="Breakpoint.Md">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Running containers (@(ViewModel!.Response?.Count ?? 0))</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@(() => ViewModel!.RefreshAsync())" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Image</MudTh>
        <MudTh>State</MudTh>
        <MudTh>Ports</MudTh>
        <MudTh>Discovered</MudTh>
        <MudTh>Mapping</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name"><code>@context.Name</code></MudTd>
        <MudTd DataLabel="Image">@context.Image</MudTd>
        <MudTd DataLabel="State">
            <MudChip T="string" Size="Size.Small" Color="@(context.State == "running" ? Color.Success : Color.Default)">@context.State</MudChip>
        </MudTd>
        <MudTd DataLabel="Ports">
            @if (context.Ports.Count == 0)
            {
                <span class="mud-text-secondary">—</span>
            }
            else
            {
                @foreach (var port in context.Ports)
                {
                    <div><code>@port.PrivatePort/@port.Type</code>@(port.PublicPort is { } pub ? $" → {pub}" : "")</div>
                }
            }
        </MudTd>
        <MudTd DataLabel="Discovered">
            <MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)">
                @(context.Enabled ? "labels" : "no labels")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Mapping">
            @if (context.RouteId is { } routeId)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.Edit">@routeId</MudChip>
            }
            else
            {
                <span class="mud-text-secondary">—</span>
            }
        </MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddLink"
                       OnClick="@(() => ImportAsync(context))">Import as mapping</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No running containers found.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private async Task ImportAsync(ContainerView container)
    {
        var parameters = new DialogParameters<MappingEditorDialog>
        {
            { x => x.Model, container.Suggested },
            { x => x.IsNew, true },
        };

        var dialog = await DialogService.ShowAsync<MappingEditorDialog>("Import container as mapping", parameters);
        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: RouteMapping mapping })
        {
            return;
        }

        var error = await ViewModel!.ImportAsync(mapping, container.Name);
        if (error is null)
        {
            Snackbar.Add($"Mapping '{mapping.Id ?? container.Name}' saved.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    protected override ContainersViewModel CreateViewModel(IServiceProvider serviceProvider) =>
        serviceProvider.GetRequiredService<ContainersViewModel>();
}
